<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_view_ribbon_website_editor" model="ir.ui.view">
        <field name="name">product.template.form.ribbon.website.editor</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="website_sale.product_template_form_view"/>
        <field name="arch" type="xml">
            <!-- Odoo reserva esta opción a Ajustes (base.group_no_one).
                 Los usuarios Editor and Designer ya pueden editar el sitio y
                 sólo necesitan leer y seleccionar las cintas existentes. -->
            <!-- website_ribbon_id pasa de Many2one a Many2many en
                 models/product_template_ribbon.py: se permite elegir varias
                 cintas con el mismo campo nativo, por eso el widget cambia a
                 many2many_tags. -->
            <field name="website_ribbon_id" position="attributes">
                <attribute name="groups">website.group_website_designer</attribute>
                <attribute name="widget">many2many_tags</attribute>
                <attribute name="options">{'no_quick_create': True}</attribute>
            </field>
        </field>
    </record>
</odoo>
