<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="s_asv_hero" name="ASVETEC Hero">
        <section class="s_asv_hero asv-hero" data-snippet="s_asv_hero">
            <!-- Stripe decorativa top -->
            <div class="asv-top-stripe" aria-hidden="true"/>

            <div class="asv-hero-grid">
                <!-- Panel izquierdo cyan -->
                <div class="asv-hero-panel">
                    <!-- Watermark decorativo -->
                    <div class="asv-hero-watermark" aria-hidden="true">ASVETEC</div>

                    <div class="asv-hero-content">
                        <div class="asv-hero-badge">
                            <span class="asv-hero-badge-dot"/>
                            10 años en el norte de Chile
                        </div>

                        <h1 class="asv-hero-title">
                            Soluciones industriales <em>rápidas y confiables.</em>
                        </h1>

                        <p class="asv-hero-sub">
                            10 años en equipos para taller, automatización neumática y electrónica,
                            y servicio en faena minera desde Arica hasta Atacama.
                        </p>

                        <div class="asv-hero-ctas">
                            <a href="/shop" class="asv-btn asv-btn-dark">
                                Ver catálogo
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                                    <line x1="5" y1="12" x2="19" y2="12"/>
                                    <polyline points="12 5 19 12 12 19"/>
                                </svg>
                            </a>
                            <a href="#contacto" class="asv-btn asv-btn-ghost">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/>
                                </svg>
                                Contáctanos
                            </a>
                        </div>

                        <div class="asv-hero-stats">
                            <div class="asv-hero-stat">
                                <span class="asv-hero-stat-num">10+</span>
                                <span class="asv-hero-stat-label">años en faena</span>
                            </div>
                            <div class="asv-hero-stat">
                                <span class="asv-hero-stat-num">5</span>
                                <span class="asv-hero-stat-label">regiones</span>
                            </div>
                            <div class="asv-hero-stat">
                                <span class="asv-hero-stat-num">14</span>
                                <span class="asv-hero-stat-label">marcas representadas</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Panel derecho — foto de taller -->
                <div class="asv-hero-photo"
                     style="background-image: url('/web_asvetec/static/src/img/hero-workshop.jpg');">
                    <div class="asv-hero-photo-overlay"/>
                    <!-- Tarjeta flotante -->
                    <div class="asv-hero-float-card">
                        <div class="asv-hero-float-eyebrow">Servicio en terreno</div>
                        <p class="asv-hero-float-text">
                            Diagnóstico y reparación de equipos directamente en su faena minera
                            o instalación industrial.
                        </p>
                    </div>
                </div>
            </div>
        </section>
    </template>
</odoo>
