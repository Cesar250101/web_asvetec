<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Sobreescribe la página /contactus nativa de Odoo con el diseño de ASVETEC.
        Solo aplica cuando el sitio web se llama 'ASVETEC'.
        El formulario usa /website/form/ + data-model_name="crm.lead" para
        que las solicitudes lleguen directamente al CRM de Odoo.
    -->
    <template id="asv_contactus" inherit_id="website.contactus"
              name="ASVETEC Contact Us" priority="20">
        <xpath expr="//div[@id='wrap']" position="replace">
            <t t-if="website and website.name == 'ASVETEC'">
                <div id="wrap">
                    <section class="s_asv_contact asv-contact" id="contacto">
                        <div class="asv-contact-stripe" aria-hidden="true"/>
                        <div class="asv-container">
                            <div class="asv-contact-grid">

                                <!-- Columna izquierda: info de contacto -->
                                <div class="asv-contact-info">
                                    <div class="asv-eyebrow" style="color: var(--asv-cyan-300);">Cotización rápida</div>
                                    <h1 class="asv-h2 asv-h2-ondark">
                                        Hablemos de su próximo equipo o servicio en faena.
                                    </h1>
                                    <p class="asv-p asv-p-ondark">
                                        Cuéntenos qué necesita. Un asesor técnico revisa cada
                                        solicitud y responde con cotización dentro de la jornada hábil.
                                    </p>

                                    <div class="asv-contact-rows">
                                        <div class="asv-contact-row">
                                            <div class="asv-contact-row-icon">
                                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                    <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/>
                                                </svg>
                                            </div>
                                            <div>
                                                <div class="asv-contact-row-label">Teléfono fijo</div>
                                                <div class="asv-contact-row-value">
                                                    <a href="tel:+56552936063" style="color:inherit;text-decoration:none;">+56 55 293 6063</a>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="asv-contact-row">
                                            <div class="asv-contact-row-icon">
                                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                    <rect x="2" y="4" width="20" height="16" rx="2"/><path d="M2 7l10 7 10-7"/>
                                                </svg>
                                            </div>
                                            <div>
                                                <div class="asv-contact-row-label">Correo de ventas</div>
                                                <div class="asv-contact-row-value">
                                                    <a href="mailto:ventas@asvetec.cl" style="color:inherit;text-decoration:none;">ventas@asvetec.cl</a>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="asv-contact-row">
                                            <div class="asv-contact-row-icon">
                                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                    <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/>
                                                </svg>
                                            </div>
                                            <div>
                                                <div class="asv-contact-row-label">Dirección</div>
                                                <div class="asv-contact-row-value">Antofagasta, II Región · Chile</div>
                                            </div>
                                        </div>
                                        <div class="asv-contact-row">
                                            <div class="asv-contact-row-icon">
                                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                    <circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/>
                                                    <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
                                                </svg>
                                            </div>
                                            <div>
                                                <div class="asv-contact-row-label">Sitio web</div>
                                                <div class="asv-contact-row-value">asvetec.cl</div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="asv-contact-emergency">
                                        <div class="asv-contact-emergency-label">Servicio de emergencia</div>
                                        <p class="asv-contact-emergency-text">
                                            Para detenciones críticas en faena, comuníquese directamente
                                            con nuestra mesa de turno. Tiempo de respuesta promedio:
                                            <strong>24 horas en sitio</strong>.
                                        </p>
                                    </div>
                                </div>

                                <!-- Columna derecha: formulario -->
                                <div class="asv-contact-form-wrap">
                                    <div class="asv-contact-form-title">Solicitar cotización</div>
                                    <p class="asv-contact-form-subtitle">
                                        Todos los campos con * son obligatorios.
                                        Respuesta en menos de 24 horas hábiles.
                                    </p>

                                    <!--
                                        Usa /website/form/ para que Odoo procese el envío y
                                        cree automáticamente un lead en el CRM.
                                        data-success-page redirige a /contactus-thank-you.
                                    -->
                                    <form id="contactus_form"
                                          class="asv-contact-form o_mark_required"
                                          action="/website/form/"
                                          method="post"
                                          enctype="multipart/form-data"
                                          data-mark="*"
                                          data-model_name="crm.lead"
                                          data-success-mode="redirect"
                                          data-success-page="/contactus-thank-you"
                                          data-pre-fill="true">

                                        <div class="asv-form-row-2">
                                            <label class="asv-form-field">
                                                <span class="asv-form-label">Nombre *</span>
                                                <input class="asv-input s_website_form_input"
                                                       type="text" name="contact_name" required="1"
                                                       placeholder="Tu nombre"
                                                       data-fill-with="name"/>
                                            </label>
                                            <label class="asv-form-field">
                                                <span class="asv-form-label">Empresa</span>
                                                <input class="asv-input s_website_form_input"
                                                       type="text" name="partner_name"
                                                       placeholder="Razón social"
                                                       data-fill-with="commercial_company_name"/>
                                            </label>
                                        </div>

                                        <div class="asv-form-row-2">
                                            <label class="asv-form-field">
                                                <span class="asv-form-label">Teléfono</span>
                                                <input class="asv-input s_website_form_input"
                                                       type="tel" name="phone"
                                                       placeholder="+56 9 …"
                                                       data-fill-with="phone"/>
                                            </label>
                                            <label class="asv-form-field">
                                                <span class="asv-form-label">Email *</span>
                                                <input class="asv-input s_website_form_input"
                                                       type="email" name="email_from" required="1"
                                                       placeholder="tu@empresa.cl"
                                                       data-fill-with="email"/>
                                            </label>
                                        </div>

                                        <label class="asv-form-field asv-form-field-full">
                                            <span class="asv-form-label">Categoría de interés</span>
                                            <select class="asv-input s_website_form_input" name="tag_ids">
                                                <option value="">Seleccionar categoría…</option>
                                                <option>Limpieza Industrial</option>
                                                <option>Equipos de Taller</option>
                                                <option>Generadores</option>
                                                <option>Arriendo de Equipos</option>
                                                <option>Herramientas</option>
                                                <option>Insumos</option>
                                                <option>Instalaciones Industriales</option>
                                                <option>Servicio técnico en faena</option>
                                                <option>Otro</option>
                                            </select>
                                        </label>

                                        <label class="asv-form-field asv-form-field-full">
                                            <span class="asv-form-label">Mensaje *</span>
                                            <textarea class="asv-input s_website_form_input"
                                                      name="description" rows="4" required="1"
                                                      placeholder="Detalla el equipo o servicio que necesitas, cantidad, ubicación de faena y plazos."/>
                                        </label>

                                        <!-- Campo oculto: asunto del lead -->
                                        <input type="hidden" name="name"
                                               id="asv_lead_name"
                                               value="Cotización web — ASVETEC"/>

                                        <div class="asv-form-footer">
                                            <label class="asv-form-privacy">
                                                <input type="checkbox" required="1"/>
                                                Acepto la
                                                <a href="/page/privacy-policy" target="_blank">política de privacidad</a>
                                            </label>
                                            <button type="submit" class="asv-btn asv-btn-primary asv-btn-lg s_website_form_send">
                                                Enviar solicitud
                                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                                                    <line x1="22" y1="2" x2="11" y2="13"/>
                                                    <polygon points="22 2 15 22 11 13 2 9 22 2"/>
                                                </svg>
                                            </button>
                                        </div>

                                        <span id="s_website_form_result"/>
                                    </form>
                                </div>

                            </div>
                        </div>
                    </section>
                </div>
            </t>
            <t t-else="">
                <!-- Wrap original para otros sitios web -->
                <div id="wrap" class="oe_structure oe_empty">
                    <section class="s_title parallax s_parallax_is_fixed bg-black-50 pt24 pb24" data-vcss="001" data-snippet="s_title" data-scroll-background-ratio="1">
                        <span class="s_parallax_bg oe_img_bg" style="background-image: url('/web/image/website.s_banner_default_image'); background-position: 50% 0;"/>
                        <div class="o_we_bg_filter bg-black-50"/>
                        <div class="container">
                            <h1>Contact us</h1>
                        </div>
                    </section>
                    <section class="s_text_block pt40 pb40 o_colored_level" data-snippet="s_text_block">
                        <div class="container s_allow_columns">
                            <div class="row">
                                <div class="col-lg-8 mt-4 mt-lg-0">
                                    <form id="contactus_form" action="/website/form/" method="post"
                                          enctype="multipart/form-data" class="o_mark_required"
                                          data-mark="*" data-model_name="mail.mail"
                                          data-success-mode="redirect"
                                          data-success-page="/contactus-thank-you"
                                          data-pre-fill="true">
                                        <div class="s_website_form_rows row s_col_no_bgcolor">
                                            <div class="mb-0 py-2 col-12 s_website_form_field s_website_form_custom s_website_form_required" data-type="char">
                                                <div class="row s_col_no_resize s_col_no_bgcolor">
                                                    <label class="col-form-label col-sm-auto s_website_form_label" style="width:200px" for="contact1">
                                                        <span class="s_website_form_label_content">Name</span>
                                                        <span class="s_website_form_mark"> *</span>
                                                    </label>
                                                    <div class="col-sm">
                                                        <input id="contact1" type="text" class="form-control s_website_form_input" name="name" required="" data-fill-with="name"/>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="mb-0 py-2 col-12 s_website_form_submit" data-name="Submit Button">
                                                <div style="width:200px" class="s_website_form_label"/>
                                                <a href="#" role="button" class="btn btn-primary btn-lg s_website_form_send">Submit</a>
                                                <span id="s_website_form_result"/>
                                            </div>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </section>
                </div>
            </t>
        </xpath>
    </template>
</odoo>
